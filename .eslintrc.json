{
  "env": {
    "browser": false,
    "es2021": true,
    "mocha": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "ignorePatterns": [
    "scripts/local/**",
    "scripts/main/backup/**"
  ],
  "rules": {
    "no-unused-vars": "off",
    "no-console": "off"
  }
}
